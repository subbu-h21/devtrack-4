{
  "info": {
    "name": "TeamBoard",
    "description": "Run top to bottom. Requests 1 and 3 capture the JWT into {{access_token}} automatically. Before request 11, manually set the acmecorp company's role to 'admin' in the database, then re-run request 3 (Login) to refresh the token, then run request 11.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "access_token", "value": "" }
  ],
  "item": [
    {
      "name": "1. Register - Success",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
              "var json = pm.response.json();",
              "if (json.access) { pm.collectionVariables.set('access_token', json.access); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"acmecorp\",\n  \"password\": \"securepass123\",\n  \"company_name\": \"Acme Corp\",\n  \"email\": \"dev@acmecorp.com\"\n}"
        },
        "url": { "raw": "{{base_url}}/api/auth/register/", "host": ["{{base_url}}"], "path": ["api", "auth", "register", ""] }
      }
    },
    {
      "name": "2. Register - Duplicate Username",
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('Status is 400', function () { pm.response.to.have.status(400); });"] }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"acmecorp\",\n  \"password\": \"anotherpass123\",\n  \"company_name\": \"Someone Else\",\n  \"email\": \"someone@else.com\"\n}"
        },
        "url": { "raw": "{{base_url}}/api/auth/register/", "host": ["{{base_url}}"], "path": ["api", "auth", "register", ""] }
      }
    },
    {
      "name": "3. Login - Success",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "if (json.access) { pm.collectionVariables.set('access_token', json.access); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"acmecorp\",\n  \"password\": \"securepass123\"\n}"
        },
        "url": { "raw": "{{base_url}}/api/auth/login/", "host": ["{{base_url}}"], "path": ["api", "auth", "login", ""] }
      }
    },
    {
      "name": "4. Login - Invalid Credentials",
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('Status is 401', function () { pm.response.to.have.status(401); });"] }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"acmecorp\",\n  \"password\": \"wrongpassword\"\n}"
        },
        "url": { "raw": "{{base_url}}/api/auth/login/", "host": ["{{base_url}}"], "path": ["api", "auth", "login", ""] }
      }
    },
    {
      "name": "5. KB Query - No Token",
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('Status is 401', function () { pm.response.to.have.status(401); });"] }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"search\": \"select_related\"\n}" },
        "url": { "raw": "{{base_url}}/api/kb/query/", "host": ["{{base_url}}"], "path": ["api", "kb", "query", ""] }
      }
    },
    {
      "name": "6. KB Query - Success With Results",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Has results', function () { pm.expect(pm.response.json().count).to.be.above(0); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"search\": \"select_related\"\n}" },
        "url": { "raw": "{{base_url}}/api/kb/query/", "host": ["{{base_url}}"], "path": ["api", "kb", "query", ""] }
      }
    },
    {
      "name": "7. KB Query - Missing Search Term",
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('Status is 400', function () { pm.response.to.have.status(400); });"] }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": { "raw": "{{base_url}}/api/kb/query/", "host": ["{{base_url}}"], "path": ["api", "kb", "query", ""] }
      }
    },
    {
      "name": "8. KB Query - Zero Results",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Count is 0', function () { pm.expect(pm.response.json().count).to.eql(0); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"search\": \"zzz_nonexistent_term_zzz\"\n}" },
        "url": { "raw": "{{base_url}}/api/kb/query/", "host": ["{{base_url}}"], "path": ["api", "kb", "query", ""] }
      }
    },
    {
      "name": "9. Usage Summary - No Token",
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('Status is 401', function () { pm.response.to.have.status(401); });"] }
        }
      ],
      "request": {
        "method": "GET",
        "url": { "raw": "{{base_url}}/api/admin/usage-summary/", "host": ["{{base_url}}"], "path": ["api", "admin", "usage-summary", ""] }
      }
    },
    {
      "name": "10. Usage Summary - Client Token Forbidden",
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('Status is 403', function () { pm.response.to.have.status(403); });"] }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": { "raw": "{{base_url}}/api/admin/usage-summary/", "host": ["{{base_url}}"], "path": ["api", "admin", "usage-summary", ""] },
        "description": "Uses the CLIENT token from request 3. Before running request 11, set this company's role to 'admin' in the database and re-run request 3 to refresh {{access_token}}."
      }
    },
    {
      "name": "11. Usage Summary - Admin Token Success",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Has top_search_terms', function () { pm.expect(pm.response.json()).to.have.property('top_search_terms'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": { "raw": "{{base_url}}/api/admin/usage-summary/", "host": ["{{base_url}}"], "path": ["api", "admin", "usage-summary", ""] },
        "description": "Run after promoting acmecorp's role to 'admin' in the database and re-running request 3 (Login) to refresh {{access_token}}."
      }
    }
  ]
}
